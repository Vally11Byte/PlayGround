@page "/"
@using System.Reflection

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<p class="mt-4 text-muted">Versione: <code>@version</code></p>

@code {
    // La versione arriva da "-p:Version=..." in fase di build (vedi Dockerfile e workflow di release)
    private readonly string version = typeof(Program).Assembly
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
        .InformationalVersion ?? "sconosciuta";
}
